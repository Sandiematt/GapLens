# Copy to .streamlit/secrets.toml (git-ignored) and fill in. Never commit real keys.
# A GEMINI_API_KEY environment variable works too. Without a key, GapLens still works:
# subjects are created manually and ESE reviews come from the presentation checklist.
#
# Free tier: get a key at https://aistudio.google.com/apikey. Free-tier requests are
# rate-limited, and Google may use free-tier prompts and uploaded files to improve its
# products, so use sample or dummy course plans and answer scripts for demos.
# GapLens calls Gemini only when faculty click "Parse with Gemini" or "Generate AI review".
GEMINI_API_KEY = ""

# Optional: use only this model. Leave it out to try gemini-flash-latest first, then
# other Flash models available to your key.
# GEMINI_MODEL = "gemini-flash-latest"
